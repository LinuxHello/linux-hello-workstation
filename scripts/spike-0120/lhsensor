#!/usr/bin/env python3
"""Stand-in for the fingerprint sensor's verified event: root writes `match` or `nomatch` to the Agent's
sensor socket. Only root can open it (mode 0600). fprintd itself was not tested."""
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
s.sendto((sys.argv[1] if len(sys.argv) > 1 else "match").encode(), "/run/lhctap2/sensor")
