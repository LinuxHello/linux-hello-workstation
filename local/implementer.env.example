# Settings for the unattended implementer (ADR-0007). Copy to
#   ~/.config/linux-hello/implementer.env
# of the implementer's user and fill in. That copy is never committed.
# Read by lh-implement-next.sh and by lh-implementer.service.

# Where this repository and the linux-hello clone live for the implementer's user.
LH_TOOLING_DIR=/home/<implementer-user>/linux-hello-workstation
CLONE_DIR=/home/<implementer-user>/linux-hello

# Model server on loopback only (lh-implement.sh refuses anything else).
OLLAMA_HOST=http://127.0.0.1:11434
# Model the harness drives, and the context window the server is configured to serve it with.
OLLAMA_MODEL=<model:tag>
LH_NUM_CTX=65536
# 0 = the model does not think (both harnesses); 1 = Ollama's default. Thinking overflowed a 64k
# window on #38 in both harnesses.
LH_THINK=0
# Aider: whole (each reply replaces the file) or diff (edit blocks; appended files to themselves
# on #40, #85, #62 and #61).
LH_AIDER_EDIT_FORMAT=whole
# Claude Code's background calls; a small local model, or the same one.
LH_BG_MODEL=<small-model:tag>

# aider | claude. Pick by the trial briefs (ADR-0007, Harness by evidence).
LH_HARNESS=aider
LH_MAX_TURNS=60
# Claude Code's cap on one reply; lower moves its compaction point up (see lh-implement.sh).
LH_MAX_OUTPUT=12000
FIX_ROUNDS=2

# Loop limits.
LH_MAX_ATTEMPTS=3
LH_RUN_TIMEOUT=2h
# Optional command that exits 0 when the GPU is busy with something other than the model
# server, e.g. a check on free VRAM. Empty: only the model server's loaded models are checked.
LH_BUSY_CHECK=
