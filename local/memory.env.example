# Settings of the shared memory (ADR-0019, local/lh-memory.py). Copy to
#   ~/.config/linux-hello/memory.env
# and change what differs. That copy is never committed. Values below are the defaults unless noted.

# Where the databases live: <dir>/public and <dir>/private. The default is a directory of its own on the
# LanceDB volume: a required, encrypted, noexec mount, and AnythingLLM mounts only
# /var/lib/lancedb/anythingllm from it, so it cannot see this one. <dir>/private is created mode 0700.
# Leave this line out to use the default.
LH_MEMORY_DIR=/var/lib/lancedb/knowledge
# lancedb (production) or jsonl (a plain file; tests and tiny corpora only)
LH_MEMORY_BACKEND=lancedb

# Embeddings: the CPU Ollama instance, so the GPU models stay loaded. Rows record the model; a model
# change leaves the old rows out of search until `make memory-index` re-embeds them.
LH_EMBED_HOST=http://127.0.0.1:11435
LH_EMBED_MODEL=nomic-embed-text

# What `make memory-index` reads. A repository is private unless it says public:.
LH_MEMORY_REPOS="public:$HOME/projects/LinuxHello/linux-hello public:$HOME/projects/LinuxHello/architecture private:$HOME/projects/LinuxHello/linux-hello-workstation"
# Issues (and the briefs in their comments) of these repositories, through gh. Same public:/private: rule.
LH_MEMORY_ISSUES="public:LinuxHello/linux-hello"
# The notes vault (text only; private always). Not set by default: name it when you want it indexed.
# LH_MEMORY_NOTES=/path/to/vault
