# Which local model each role uses (local/lh-model.sh, local/claude-local-*.sh). Copy to
#   ~/.config/linux-hello/models.env
# and set every value. That copy is never committed: which models run here is a detail of the
# machine, and this repository is public (linux-hello AGENTS.md, invariant 8). The scripts have no
# built-in model names; a value that is not set stops them with a message naming it.
# Each window must equal the num_ctx the model is served with.
#
# The implementer (make implement) and the drafting jobs (make draft-brief, make draft-adr).
LH_MODEL_IMPLEMENT=your-implement-model:latest
LH_CTX_IMPLEMENT=65536
LH_MODEL_DRAFT=your-draft-model:latest
LH_CTX_DRAFT=32768
# Interactive Claude Code sessions: make claude-gpu (Ollama on :11434) and make claude-cpu (:11435).
LH_MODEL_GPU=your-gpu-model:latest
LH_CTX_GPU=65536
LH_MODEL_CPU=your-cpu-model:latest
LH_CTX_CPU=131072
