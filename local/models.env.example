# Which local model each role uses (local/lh-model.sh). Copy to
#   ~/.config/linux-hello/models.env
# and change what differs. That copy is never committed. Every value below is the default.
# The window must equal the num_ctx the model is served with.
LH_MODEL_IMPLEMENT=gemma4-26b-64k:latest
LH_CTX_IMPLEMENT=65536
LH_MODEL_DRAFT=qwen38-27b-text-32k:latest
LH_CTX_DRAFT=32768
